{
	"schemaVersion": 1,
	"id": "buildmart",
	"version": "${version}",
	"name": "BuildMart",
	"description": "为建筑玩家打造的生存整合：经济市场、箱子商店、便捷购买、刷怪笼生产、飞行传送等生活便利（不想玩生电也能轻松积累与建设）。",
	"authors": [
		"Moistrocic"
	],
	"license": "CC0-1.0",
	"icon": "assets/buildmart/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"mois.buildmart.BuildMart"
		],
		"client": [
			"mois.buildmart.client.BuildMartClient"
		]
	},
	"mixins": [
		"buildmart.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3-",
		"java": ">=25",
		"fabric-api": "*"
	}
}
